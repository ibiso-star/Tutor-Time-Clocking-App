# PostgreSQL connection string
DATABASE_URL=postgres://ttc:ttc@localhost:5432/ttc_dev
# HTTP port for the API (and built web app in production)
PORT=3000
# development | production | test
NODE_ENV=development
# Absolute base URL used when building password-reset links
APP_BASE_URL=http://localhost:5173
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Set to "false" to disable the in-process alert worker (e.g. when running a separate worker)
ALERT_WORKER_ENABLED=true
# Optional: send invite and password-reset emails through Resend (https://resend.com).
# Without these, emails are only printed to the API log.
# RESEND_API_KEY=re_...
# MAIL_FROM="Tutor Time Clock <noreply@example.org>"
