# PostgreSQL. The portal uses its own `shift` schema, so it can share a database or have its own.
DATABASE_URL=postgres://ttc:ttc@localhost:5432/shift_dev
PORT=3010
NODE_ENV=development
# Admin / integration API key: at least 32 random characters, e.g. `openssl rand -base64 36`.
PORTAL_API_KEY=
# Base URL that personal links and kiosk pairing links point to.
PUBLIC_BASE_URL=http://localhost:5180
# IANA timezone for "today" and timesheet days.
PORTAL_TIMEZONE=Europe/London
# Optional: push every punch to your main system (Standard Webhooks signing).
# WEBHOOK_URL=https://example.org/hooks/shift
# WEBHOOK_SECRET=whsec_<base64 of 32 random bytes>   e.g. echo "whsec_$(openssl rand -base64 32)"
# Database TLS: DATABASE_SSL=require (encrypted) or DATABASE_CA_CERT=<PEM> (encrypted and verified).
